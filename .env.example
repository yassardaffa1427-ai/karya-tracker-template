# Kosongkan semua VITE_FIREBASE_* untuk memakai adapter mock lokal (localStorage + seed data).
# Isi lengkap keenamnya untuk otomatis beralih ke Firebase Auth + Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set true untuk menyambung ke Firebase Emulator Suite saat dev
VITE_USE_FIREBASE_EMULATOR=false
