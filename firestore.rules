rules_version = '2';

// Otorisasi Karya Tracker (PRD bagian 9 — Security & Privacy).
// Sumber kebenaran permission ada di sini, bukan di UI.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin ditentukan dari field role di dokumen users/{uid} milik pemanggil sendiri.
    // Custom claim (kalau ada, lewat Cloud Function di masa depan) dicek lebih dulu
    // supaya lebih murah — tapi tidak wajib, karena Cloud Functions saat ini ditunda
    // dan "Undang admin" menulis role langsung ke Firestore dari klien.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Dipakai supaya orang yang diundang bisa membaca/menerima undangan
    // miliknya sendiri lewat email, tanpa perlu jadi admin dulu.
    function isInvitedSelf(invitedEmail) {
      return isSignedIn() && invitedEmail == request.auth.token.email.lower();
    }

    function validSubmission(data) {
      return data.keys().hasAll(['userId', 'name', 'origin', 'socialAccountUrl', 'linkUrl'])
        && data.userId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.origin is string && data.origin.size() > 0 && data.origin.size() <= 80
        && data.socialAccountUrl is string && data.socialAccountUrl.matches('https?://.*')
        && data.linkUrl is string && data.linkUrl.matches('https?://.*');
    }

    match /users/{userId} {
      // Nama & asal tampil di leaderboard, jadi profil bisa dibaca sesama user yang login.
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      // User boleh memperbarui profilnya sendiri (termasuk totalKarya saat submit/hapus
      // karya sendiri — leaderboard dihitung di klien, tanpa Cloud Functions) tapi tidak
      // boleh menaikkan rolenya sendiri.
      // Admin boleh: (a) menaikkan role user LAIN jadi admin (fitur "Undang admin"),
      // (b) mengoreksi totalKarya/origin/lastReachedAt user LAIN — dipakai saat admin
      // menghapus submission milik orang lain, dan saat "Recompute leaderboard"
      // (backfill agregat untuk submission yang dibuat sebelum totalKarya ada).
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'admin')
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalKarya', 'origin', 'lastReachedAt']));
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      // Histori submission hanya terlihat oleh pemiliknya dan admin (Open Question #3).
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isOwner(request.resource.data.userId)
        && validSubmission(request.resource.data);
      // Admin tidak boleh mengedit isi submission siapa pun.
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && validSubmission(request.resource.data);
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /adminInvites/{inviteId} {
      // Admin kelola semua undangan; orang yang diundang boleh baca undangan
      // miliknya sendiri — dipakai saat register/login untuk cek status invite.
      allow read: if isAdmin() || isInvitedSelf(resource.data.invitedEmail);
      allow create: if isAdmin();
      // Satu-satunya update dari klien: yang diundang menandai undangannya
      // sendiri "accepted" saat mendaftar dengan email yang sama.
      allow update: if isInvitedSelf(resource.data.invitedEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
